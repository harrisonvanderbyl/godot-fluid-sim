[configuration]
entry_symbol = "gdext_particles_init"
compatibility_minimum = "4.8"

[libraries]
linux.debug.x86_64   = "res://addons/fluid_particles/bin/libgodot_ext_particles.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/fluid_particles/bin/libgodot_ext_particles.linux.template_release.x86_64.so"
windows.debug.x86_64   = "res://addons/fluid_particles/bin/libgodot_ext_particles.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/fluid_particles/bin/libgodot_ext_particles.windows.template_release.x86_64.dll"
macos.debug   = "res://addons/fluid_particles/bin/libgodot_ext_particles.macos.template_debug.framework"
macos.release = "res://addons/fluid_particles/bin/libgodot_ext_particles.macos.template_release.framework"
